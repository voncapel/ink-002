S002_MAC=06:03:86:00:97:AB
S002_CHANNEL=1
S002_DATA_DIR=/var/lib/s002-web
# Recurring rules use the system time zone. Uncomment to force another one.
#S002_TIMEZONE=Europe/Paris
S002_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
S002_WEB_USER=printer
S002_WEB_PASSWORD=replace-with-a-long-random-password
# Bearer token for API clients such as Hermes: openssl rand -hex 32
S002_API_TOKEN=replace-with-a-long-random-token
S002_ALLOWED_PATHS=/var/lib/s002-web/inbox
OPENROUTER_API_KEY=replace-with-an-openrouter-key
OPENROUTER_MODEL=google/gemma-4-31b-it
