[Unit]
Description=Ink 002 thermal printer web relay
After=network-online.target bluetooth.service
Wants=network-online.target bluetooth.service

[Service]
Type=simple
User=tristan
Group=tristan
WorkingDirectory=/opt/s002-web
EnvironmentFile=/etc/s002-web.env
ExecStart=/opt/s002-web/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 180 --bind 127.0.0.1:8092 --access-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/s002-web
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_BLUETOOTH

[Install]
WantedBy=multi-user.target
